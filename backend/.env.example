# LLM provider: gemini | groq
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
PORT=3000
CI_SCAN_API_KEY=replace_with_a_long_random_secret
FRONTEND_ORIGIN=
LLM_MIN_INTERVAL_MS=4000

# Crawl limits (optional, these are the defaults). The crawl stops at whichever is hit first.
CRAWL_TIME_LIMIT_MS=900000
CRAWL_MAX_ACTIONS=60
CRAWL_MAX_STATES=40
CRAWL_MAX_DEPTH=6
CRAWL_NO_NOVELTY_LIMIT=12
CRAWL_MAX_LLM_CALLS=90
# false = watch the crawl happen in a visible Chrome window
CRAWL_HEADLESS=true

# Reusable test library (npm run tests -- <url>)
# Stateful tests (create/delete/cart) write real data: only enable on a test environment.
TESTS_ALLOW_MUTATIONS=false
# Optional test account: the test library logs in with it first and tests the
# pages behind the login (the invalid-login test needs none). Scans started
# from the Scan page ask for login details instead.
TEST_USERNAME=
TEST_PASSWORD=
TESTS_MAX_ELEMENT_TESTS=25
# Pages per run: the start page plus same-site links found on it. With a test
# account, the pages behind the login (the login page itself takes one slot).
TESTS_MAX_PAGES=5
# Browsers compared against Chrome (install: npx playwright install firefox webkit).
TESTS_BROWSERS=firefox,webkit
# LLM reviews of passing results, per page.
TESTS_MAX_JUDGE_CALLS=5

# MongoDB: accounts, login sessions and who owns which scan.
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=bugops

# Optional Redis cache for crawl LLM analysis. If REDIS_URL is unset or Redis
# is unavailable, scans continue through the regular LLM path.
REDIS_URL=redis://127.0.0.1:6379
SCAN_CACHE_ENABLED=true
SCAN_CACHE_TTL_SECONDS=86400

# GitHub Issues integration. Each user's GitHub token is stored encrypted
# (AES-256-GCM) with this key: 32 random bytes as 64 hex characters. Generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it secret and keep it stable: changing it makes saved tokens unreadable
# (users then reconnect). Without it, the GitHub integration is turned off.
GITHUB_TOKEN_ENCRYPTION_KEY=
