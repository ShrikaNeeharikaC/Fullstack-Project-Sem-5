GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
FRONTEND_ORIGIN=
LLM_MIN_INTERVAL_MS=4000

# Crawl limits (optional, these are the defaults). The crawl stops at whichever is hit first.
CRAWL_TIME_LIMIT_MS=300000
CRAWL_MAX_ACTIONS=25
CRAWL_MAX_STATES=15
CRAWL_MAX_DEPTH=3
CRAWL_NO_NOVELTY_LIMIT=6
CRAWL_MAX_LLM_CALLS=40
# false = watch the crawl happen in a visible Chrome window
CRAWL_HEADLESS=true
